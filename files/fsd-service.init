#!/bin/sh /etc/rc.common
START=96
STOP=12
USE_PROCD=1

start_service() {
	[ -f /etc/fsd-package/active ] || return 0
	local lan_prefix ap_section modem_interface
	read -r lan_prefix < /etc/fsd/lan-prefix || return 1
	ap_section="$(uci -q get fsd.main.ap_section)"
	modem_interface="$(uci -q get fsd.main.modem_interface)"
	nft flush set inet fw4 fsd_forward_ready 2>/dev/null || true
	procd_open_instance
	procd_set_param command /usr/sbin/fsd-service -lan "$lan_prefix" -ap-section "$ap_section" -modem-interface "$modem_interface" -forward-guard -luci
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	nft flush set inet fw4 fsd_forward_ready 2>/dev/null || true
	nft delete table inet fsd_service 2>/dev/null || true
}
